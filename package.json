{
  "name": "docknight",
  "version": "1.1.0",
  "description": "Self-hosted web manager for docker compose stacks",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">= 24"
  },
  "scripts": {
    "start": "node backend/index.ts",
    "dev:backend": "node --watch backend/index.ts --data-dir ./.dev/data --stacks-dir ./.dev/stacks --log-level debug",
    "dev:frontend": "vite dev",
    "build": "pnpm run build:frontend",
    "build:frontend": "vite build",
    "build:audit": "vite build --config vite.audit.config.ts",
    "build:verify": "pnpm run i18n:pseudo && vite build --mode verify && pnpm run build:audit",
    "preview": "vite preview",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit && node node_modules/@typescript/native/bin/tsc --noEmit -p frontend/tsconfig.json && node node_modules/@typescript/native/bin/tsc --noEmit -p tests/tsconfig.json",
    "theme:generate": "node tools/theme/generate.ts",
    "i18n:pseudo": "node tools/i18n/pseudo.ts",
    "lint:js": "eslint .",
    "lint:style": "stylelint \"frontend/src/**/*.{css,svelte}\"",
    "lint": "pnpm run lint:js && pnpm run lint:style",
    "test": "node --test \"backend/**/*.test.ts\" \"common/**/*.test.ts\"",
    "test:layout": "playwright test --project layout",
    "test:a11y": "playwright test --project a11y",
    "test:ui": "playwright test",
    "fixtures": "node tools/fixtures/serve.ts",
    "reset-password": "node scripts/reset-password.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "composerize": "^1.7.6",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.38.6",
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-kr": "^5.3.0",
    "@ktibow/material-color-utilities-nightly": "^0.4.1772748028000",
    "@lezer/highlight": "^1.2.3",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "axe-core": "^4.13.0",
    "codemirror": "^6.0.2",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.14.0",
    "globals": "^17.9.0",
    "m3-svelte": "^5.15.5",
    "postcss-html": "^2.0.0",
    "postcss-value-parser": "^4.2.0",
    "qrcode": "^1.5.4",
    "stylelint": "^17.14.1",
    "svelte": "^5.56.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.1"
  }
}
