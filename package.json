{
  "name": "docknight",
  "version": "0.1.0",
  "description": "Self-hosted web manager for docker compose stacks",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">= 24"
  },
  "scripts": {
    "dev:backend": "node --watch backend/index.ts --data-dir .dev/data --stacks-dir .dev/stacks --log-level debug",
    "dev:frontend": "vite dev",
    "build:frontend": "vite build",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test \"backend/**/*.test.ts\" \"common/**/*.test.ts\" \"scripts/**/*.test.ts\" \"tests/**/*.test.ts\"",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test",
    "reset-password": "node scripts/reset-password.ts"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
