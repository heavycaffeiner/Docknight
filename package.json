{
  "name": "docknight",
  "version": "1.7.2",
  "description": "Self-hosted control panel for Docker Compose stacks",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">= 24"
  },
  "scripts": {
    "dev:backend": "node --watch backend/index.ts --data-dir .dev/data --stacks-dir .dev/stacks --log-level debug",
    "dev:frontend": "vite dev",
    "build:frontend": "vite build",
    "fixtures": "node tools/fixtures/cli.ts",
    "typecheck": "node node_modules/@typescript/native/bin/tsc --noEmit && node node_modules/@typescript/native/bin/tsc -p frontend/tsconfig.json --noEmit && node node_modules/@typescript/native/bin/tsc -p tools/theme/tsconfig.json --noEmit && node node_modules/@typescript/native/bin/tsc -p tools/audit/tsconfig.json --noEmit && node node_modules/@typescript/native/bin/tsc -p tests/layout/tsconfig.json --noEmit && node node_modules/@typescript/native/bin/tsc -p tests/a11y/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:style": "stylelint \"frontend/**/*.{css,svelte}\"",
    "test": "node --test \"backend/**/*.test.ts\" \"common/**/*.test.ts\" \"docker/**/*.test.ts\" \"scripts/**/*.test.ts\" \"tests/**/*.test.ts\" \"tools/**/*.test.ts\"",
    "pretest:layout": "node tools/i18n/pseudo.ts",
    "test:layout": "playwright test --config tests/layout/playwright.config.ts",
    "pretest:a11y": "node tools/i18n/pseudo.ts",
    "test:a11y": "playwright test --config tests/a11y/playwright.config.ts",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run lint:style && pnpm run test && pnpm run test:layout && pnpm run test:a11y",
    "reset-password": "node scripts/reset-password.ts"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.14.1",
    "composerize": "^1.7.6",
    "ws": "^8.21.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@eslint/js": "^10.0.1",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@ktibow/material-color-utilities-nightly": "^0.4.1772748028000",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/ws": "^8.18.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "axe-core": "^4.13.0",
    "codemirror": "^6.0.2",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.9.0",
    "m3-svelte": "^7.2.0",
    "postcss-html": "^2.0.0",
    "postcss-value-parser": "^4.2.0",
    "qrcode": "^1.5.4",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "svelte": "^5.56.9",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vite-plugin-compression2": "^2.5.3"
  }
}
