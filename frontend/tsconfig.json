{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "lib": ["es2024", "dom", "dom.iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],
    "paths": {
      "$common/*": ["../common/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.svelte",
    "src/**/*.d.ts",
    "../common/**/*.ts",
    "../tools/overlay/**/*.ts",
    "../tools/audit/**/*.ts"
  ],
  "exclude": [
    "../common/**/*.test.ts",
    "../tools/audit/exemptions.ts",
    "../tools/audit/report.ts"
  ]
}
